# MongoDB
MONGODB_URI=mongodb://localhost:27017/collabspace
# For Docker: MONGODB_URI=mongodb://mongo:27017/collabspace
# For Atlas:  MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/collabspace

# JWT
JWT_SECRET_KEY=your-strong-secret-key-here
JWT_EXPIRATION_HOURS=24

# Server
PORT=8080
CORS_ORIGINS=http://localhost:3000
# For production: CORS_ORIGINS=https://your-app.vercel.app
